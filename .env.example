# Neon connection string (Neon console -> Connect -> pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Shared password organizers use to sign in to /admin
ADMIN_PASSWORD=change-me

# Random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string
